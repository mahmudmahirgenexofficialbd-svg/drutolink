{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:id", "destination": "/api/product-page?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
